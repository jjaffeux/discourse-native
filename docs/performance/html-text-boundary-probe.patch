+// Temporary investigation instrumentation; not shipping code.
+class ConversionProbe {
+  static bool optimized = false;
+  static bool countMatches = false;
+  static final conversions = <int>[];
+  static final ticks = <String, int>{};
+  static final counts = <String, int>{};
+  static T measure<T>(String name, T Function() body) {
+    final timer = Stopwatch()..start();
+    try { return body(); } finally {
+      if (name == 'conversion') conversions.add(timer.elapsedTicks);
+      ticks.update(name, (n) => n + timer.elapsedTicks, ifAbsent: () => timer.elapsedTicks);
+      counts.update(name, (n) => n + 1, ifAbsent: () => 1);
+    }
+  }
+  static void reset() { ticks.clear(); counts.clear(); conversions.clear(); }
+  static Map<String, Object> snapshot() => {
+    'conversionUs': conversions.map((n) => n * 1000000 / Stopwatch().frequency).toList(),
+    'us': ticks.map((key, value) => MapEntry(key, value * 1000000 / Stopwatch().frequency)),
+    'counts': Map<String, int>.of(counts),
+  };
+}
