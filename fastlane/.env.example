# Store this JSON file outside the repository. It uses Fastlane's API-key JSON
# format and contains key_id, issuer_id, and the private key.
# Use a team API key with access to signing resources for team 6T3LU73T8S.
# The lane also passes this key to Xcode for automatic archive/export signing.
APP_STORE_CONNECT_API_KEY_PATH=/absolute/path/to/app-store-connect-api-key.json

# Optional: select installed App Store profiles for local distribution signing.
# These profiles must include the Apple Distribution identity in your keychain.
# macOS exports also require a Mac Installer Distribution identity.
# Without a profile, the platform continues to use Xcode's automatic signing.
FASTLANE_IOS_PROVISIONING_PROFILE=
FASTLANE_MACOS_PROVISIONING_PROFILE=

# Set this only after confirming the app's export-compliance classification.
FASTLANE_USES_NON_EXEMPT_ENCRYPTION=CHANGE_ME_TO_TRUE_OR_FALSE
