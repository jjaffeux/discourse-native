opt_out_usage

default_platform(:ios)

platform :ios do
  desc "Run the local checks and create an unsigned TestFlight archive"
  lane :preflight do
    project_root = File.expand_path("..", __dir__)

    Dir.chdir(project_root) do
      sh("flutter", "pub", "get", "--enforce-lockfile")
      sh(
        "dart",
        "format",
        "--output=none",
        "--set-exit-if-changed",
        "lib",
        "test",
        "integration_test",
        "tool"
      )
      sh("flutter", "analyze")
      sh("flutter", "test")
      sh("flutter", "build", "ipa", "--release", "--no-codesign")
    end
  end
end
