# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Per-user Claude Code settings. The shared .claude/settings.json is tracked;
# this one is local overrides and should not be.
.claude/settings.local.json

# linux/ has its own .gitignore for flutter/ephemeral, as ios/ and macos/ do.

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
**/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Exported release signing bundles. Encrypted, but private material -- back
# them up out of band, never in the repo.
*.dukey

# Fastlane output and Apple credentials. API keys and signing material must be
# stored outside the repository.
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/
fastlane/.env
fastlane/.env.*
!fastlane/.env.example
fastlane/*api*key*.json
*.p8
*.p12
*.mobileprovision
